{
  "expo": {
    "name": "opentaskit",
    "slug": "opentaskit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-brand.png",
    "scheme": "opentaskit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/icon-brand.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0094F7",
        "foregroundImage": "./assets/brand/icon-brand.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.opentaskit"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0094F7",
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OpenTaskit to access your photos to attach images to your task.",
          "cameraPermission": "Allow OpenTaskit to access your camera to take photos for your task."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow OpenTaskit to access your location to find nearby tasks and set task locations."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
