// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String     @id @default(uuid())
  fullName           String
  email              String     @unique
  phoneNumber        String
  password           String
  role               Role       @default(USER)
  status             UserStatus @default(ACTIVE)
  termsAcceptedAt    DateTime   @default(now())
  hashedRefreshToken String?

  resetOtpHash      String?
  resetOtpExpiresAt DateTime?

  avatarUrl String?
  headline  String?
  bio       String?
  location  String?
  skills    String[] @default([])

  rating      Float @default(0)
  reviewCount Int   @default(0)

  isVerified Boolean @default(false)

  lastActiveAt DateTime @default(now())

  // relations
  kycVerifications KycVerification[] @relation("UserKyc")
  adminKycReviews  KycVerification[] @relation("AdminKycReviews")
  tasks            Task[]
  savedTasks       SavedTask[]
  offers           Offer[]
  reviewsGiven     Review[]          @relation("ReviewsGiven")
  reviewsReceived  Review[]          @relation("ReviewsReceived")
  notifications    Notification[]
  pushTokens       PushToken[]
  disputesRaised   Dispute[]         @relation("DisputesRaised")
  disputesAgainst  Dispute[]         @relation("DisputesAgainst")
  disputesResolved Dispute[]         @relation("DisputesResolved")

  wallet           Wallet?
  payments         Payment[]
  walletTopUps     WalletTopUp[]
  bankAccounts     BankAccount[]
  payoutsProcessed PayoutRequest[]   @relation("PayoutsProcessed")

  messagesSent     Message[]         @relation("MessagesSent")
  messagesReceived Message[]         @relation("MessagesReceived")

  providerServices ProviderService[]
  portfolioItems   PortfolioItem[]
  problemReports   ProblemReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProviderService {
  id        String   @id @default(uuid())
  name      String
  fromPrice Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PortfolioItem {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model KycVerification {
  id              String          @id @default(uuid())
  documentType    KycDocumentType
  idNumber        String
  fullName        String?
  dob             String?
  frontPhotoUrl   String
  backPhotoUrl    String?
  selfieUrl       String?
  status          KycStatus       @default(PENDING)
  rejectionReason String?         @db.Text
  reviewNotes     String?         @db.Text

  userId String
  user   User   @relation("UserKyc", fields: [userId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?     @relation("AdminKycReviews", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  icon        String? // Icon name, SVG, or URL                        
  description String?
  isActive    Boolean @default(true)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id      String   @id @default(uuid())
  title   String
  details String   @db.Text
  images  String[]

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  locationType LocationType @default(IN_PERSON)
  address      String?
  latitude     Float?
  longitude    Float?

  budget           Float
  isBudgetFlexible Boolean       @default(false)
  paymentMethod    PaymentMethod @default(CASH)

  timeType      TimeType  @default(ASAP)
  scheduledDate DateTime?
  scheduledTime String?

  status TaskStatus @default(OPEN)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  savedBy    SavedTask[]
  offers     Offer[]
  reviews    Review[]
  disputes   Dispute[]
  payments   Payment[]
  escrowHold EscrowHold?
  messages   Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedTask {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, taskId])
}

model Offer {
  id      String      @id @default(uuid())
  amount  Float
  message String      @db.Text
  status  OfferStatus @default(PENDING)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, userId])
}

model Review {
  id     String   @id @default(uuid())
  rating Int // 1 to 5                                                         
  text   String   @db.Text
  tags   String[] // e.g. ["On time", "Professional", "High quality"]               

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User   @relation("ReviewsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId String
  toUser   User   @relation("ReviewsReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  isHidden         Boolean @default(false)
  moderationReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, fromUserId])
}

model Notification {
  id     String           @id @default(uuid())
  type   NotificationType @default(SYSTEM)
  title  String
  body   String           @db.Text
  isRead Boolean          @default(false)

  // Context metadata (e.g. navigation link)                                            
  taskId    String?
  actionUrl String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
}

model Dispute {
  id              String             @id @default(uuid())
  reason          DisputeReason
  description     String             @db.Text
  evidenceUrls    String[]           @default([])
  status          DisputeStatus      @default(OPEN)
  resolution      DisputeResolution?
  resolutionNotes String?            @db.Text

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  raisedById String
  raisedBy   User   @relation("DisputesRaised", fields: [raisedById], references: [id], onDelete: Cascade)

  againstUserId String
  againstUser   User   @relation("DisputesAgainst", fields: [againstUserId], references: [id], onDelete: Cascade)

  resolvedById String?
  resolvedBy   User?     @relation("DisputesResolved", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([raisedById])
  @@index([againstUserId])
  @@index([status])
}

// A conversation is identified by (taskId, the two participants) rather than
// taskId alone - a task can have several prospective taskers messaging the
// poster before one is accepted, so taskId by itself doesn't uniquely
// identify a thread.
model Message {
  id            String  @id @default(uuid())
  text          String? @db.Text
  attachmentUrl String?
  isRead        Boolean @default(false)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String
  receiver   User   @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([senderId])
  @@index([receiverId, isRead])
}

enum KycDocumentType {
  NIC
  DRIVING_LICENSE
  PASSPORT
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DisputeReason {
  WORK_UNSATISFACTORY
  TASKER_NO_SHOW
  POSTER_UNRESPONSIVE
  PAYMENT_ISSUE
  HARASSMENT
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum DisputeResolution {
  REFUND_POSTER
  PAY_TASKER
  CANCELLED_NO_PENALTY
  DISMISSED
}

enum NotificationType {
  OFFER
  TASK
  MESSAGE
  REVIEW
  PAYMENT
  DISPUTE
  SYSTEM
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TaskStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  DISPUTED
}

enum LocationType {
  IN_PERSON
  REMOTE
}

enum TimeType {
  ASAP
  SPECIFIC_DATE
  FLEXIBLE
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

// ---------------------------------------------------------------------------
// Payments & Escrow
// ---------------------------------------------------------------------------

model Wallet {
  id               String @id @default(uuid())
  userId           String @unique
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableBalance Float  @default(0)

  transactions   WalletTransaction[]
  payoutRequests PayoutRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id       String                @id @default(uuid())
  walletId String
  wallet   Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type     WalletTransactionType

  // Positive = credit to wallet, negative = debit.
  amount       Float
  balanceAfter Float

  taskId          String?
  escrowHoldId    String?
  payoutRequestId String?
  walletTopUpId   String?
  description     String?

  createdAt DateTime @default(now())

  @@index([walletId])
}

// One row per PayHere hosted-checkout attempt for funding a task's escrow.
model Payment {
  id      String        @id @default(uuid())
  taskId  String
  task    Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  payerId String
  payer   User          @relation(fields: [payerId], references: [id], onDelete: Cascade)
  amount  Float
  currency String       @default("LKR")
  status  PaymentStatus @default(INITIATED)

  // PayHere identifiers - orderId is ours (generated), paymentId is theirs (from IPN).
  payhereOrderId    String @unique
  payherePaymentId  String?
  payhereRawPayload Json?

  escrowHold EscrowHold?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([payerId])
}

// One row per PayHere checkout attempt for topping up a user's own wallet
// (as opposed to Payment, which always funds a specific task's escrow).
model WalletTopUp {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount Float
  currency String        @default("LKR")
  status   PaymentStatus @default(INITIATED)

  payhereOrderId    String @unique
  payherePaymentId  String?
  payhereRawPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Funds held against a single assigned task until release/refund.
model EscrowHold {
  id        String  @id @default(uuid())
  taskId    String  @unique
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amount      Float // full amount held (the accepted offer amount)
  platformFee Float @default(0) // computed at release time from PlatformConfig

  status EscrowStatus @default(HELD)

  releasedAt       DateTime?
  refundedAt       DateTime?
  resolutionSource String? // COMPLETION | DISPUTE | CANCELLATION

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankAccount {
  id                String  @id @default(uuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName          String
  branch            String
  accountHolderName String
  accountNumber     String
  isDefault         Boolean @default(true)

  payoutRequests PayoutRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PushToken {
  id       String @id @default(uuid())
  token    String @unique
  platform String @default("android")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PayoutRequest {
  id            String      @id @default(uuid())
  walletId      String
  wallet        Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  amount        Float
  status        PayoutStatus @default(PENDING)

  processedById String?
  processedBy   User?     @relation("PayoutsProcessed", fields: [processedById], references: [id])
  processedAt   DateTime?
  adminNotes    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId])
  @@index([status])
}

// Singleton row holding platform-wide, admin-configurable payment settings.
model PlatformConfig {
  id                    String   @id @default("singleton")
  platformFeePercent    Float    @default(10)
  minTaskBudgetLkr      Float    @default(1000)
  supportEmail          String   @default("support@opentaskit.com")
  supportHotline        String   @default("+94 11 234 5678")
  whatsappSupportNumber String   @default("+94 77 123 4567")
  updatedAt             DateTime @updatedAt
}

// Admin-editable legal content (Terms of Service, Privacy Policy) rendered
// directly in the mobile app. `slug` is a plain string ("terms" | "privacy")
// rather than an enum so new documents don't require a migration.
model LegalDocument {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  version   String   @default("1.0.0")
  sections  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ReportCategory {
  TASK_OR_PROVIDER_ISSUE
  PAYMENT_OR_WALLET
  ACCOUNT_AND_LOGIN
  SAFETY_AND_TRUST
  APP_BUG_TECHNICAL
  OTHER
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

model ProblemReport {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    ReportCategory @default(OTHER)
  taskRef     String?
  description String         @db.Text
  images      String[]       @default([])
  status      ReportStatus   @default(OPEN)
  adminNotes  String?        @db.Text
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum PaymentStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

enum WalletTransactionType {
  ESCROW_RELEASE
  PLATFORM_FEE
  WITHDRAWAL
  ADJUSTMENT
  TOPUP
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}
