// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String     @id @default(uuid())
  fullName           String
  email              String     @unique
  phoneNumber        String
  password           String
  role               Role       @default(USER)
  status             UserStatus @default(ACTIVE)
  termsAcceptedAt    DateTime   @default(now())
  hashedRefreshToken String?

  resetOtpHash      String?
  resetOtpExpiresAt DateTime?

  avatarUrl String?
  headline  String?
  bio       String?
  location  String?
  skills    String[] @default([])

  rating      Float @default(0)
  reviewCount Int   @default(0)

  isVerified Boolean @default(false)

  // relations
  kycVerifications KycVerification[] @relation("UserKyc")
  adminKycReviews  KycVerification[] @relation("AdminKycReviews")
  tasks            Task[]
  savedTasks       SavedTask[]
  offers           Offer[]
  reviewsGiven     Review[]          @relation("ReviewsGiven")
  reviewsReceived  Review[]          @relation("ReviewsReceived")
  notifications    Notification[]
  disputesRaised   Dispute[]         @relation("DisputesRaised")
  disputesAgainst  Dispute[]         @relation("DisputesAgainst")
  disputesResolved Dispute[]         @relation("DisputesResolved")

  wallet           Wallet?
  payments         Payment[]
  bankAccounts     BankAccount[]
  payoutsProcessed PayoutRequest[]   @relation("PayoutsProcessed")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KycVerification {
  id              String          @id @default(uuid())
  documentType    KycDocumentType
  idNumber        String
  fullName        String?
  dob             String?
  frontPhotoUrl   String
  backPhotoUrl    String?
  selfieUrl       String?
  status          KycStatus       @default(PENDING)
  rejectionReason String?         @db.Text
  reviewNotes     String?         @db.Text

  userId String
  user   User   @relation("UserKyc", fields: [userId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?     @relation("AdminKycReviews", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  icon        String? // Icon name, SVG, or URL                        
  description String?
  isActive    Boolean @default(true)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id      String   @id @default(uuid())
  title   String
  details String   @db.Text
  images  String[]

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  locationType LocationType @default(IN_PERSON)
  address      String?
  latitude     Float?
  longitude    Float?

  budget           Float
  isBudgetFlexible Boolean       @default(false)
  paymentMethod    PaymentMethod @default(CASH)

  timeType      TimeType  @default(ASAP)
  scheduledDate DateTime?
  scheduledTime String?

  status TaskStatus @default(OPEN)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  savedBy    SavedTask[]
  offers     Offer[]
  reviews    Review[]
  disputes   Dispute[]
  payments   Payment[]
  escrowHold EscrowHold?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedTask {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, taskId])
}

model Offer {
  id      String      @id @default(uuid())
  amount  Float
  message String      @db.Text
  status  OfferStatus @default(PENDING)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, userId])
}

model Review {
  id     String   @id @default(uuid())
  rating Int // 1 to 5                                                         
  text   String   @db.Text
  tags   String[] // e.g. ["On time", "Professional", "High quality"]               

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User   @relation("ReviewsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)

  toUserId String
  toUser   User   @relation("ReviewsReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  isHidden         Boolean @default(false)
  moderationReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taskId, fromUserId])
}

model Notification {
  id     String           @id @default(uuid())
  type   NotificationType @default(SYSTEM)
  title  String
  body   String           @db.Text
  isRead Boolean          @default(false)

  // Context metadata (e.g. navigation link)                                            
  taskId    String?
  actionUrl String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
}

model Dispute {
  id              String             @id @default(uuid())
  reason          DisputeReason
  description     String             @db.Text
  evidenceUrls    String[]           @default([])
  status          DisputeStatus      @default(OPEN)
  resolution      DisputeResolution?
  resolutionNotes String?            @db.Text

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  raisedById String
  raisedBy   User   @relation("DisputesRaised", fields: [raisedById], references: [id], onDelete: Cascade)

  againstUserId String
  againstUser   User   @relation("DisputesAgainst", fields: [againstUserId], references: [id], onDelete: Cascade)

  resolvedById String?
  resolvedBy   User?     @relation("DisputesResolved", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([raisedById])
  @@index([againstUserId])
  @@index([status])
}

enum KycDocumentType {
  NIC
  DRIVING_LICENSE
  PASSPORT
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DisputeReason {
  WORK_UNSATISFACTORY
  TASKER_NO_SHOW
  POSTER_UNRESPONSIVE
  PAYMENT_ISSUE
  HARASSMENT
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum DisputeResolution {
  REFUND_POSTER
  PAY_TASKER
  CANCELLED_NO_PENALTY
  DISMISSED
}

enum NotificationType {
  OFFER
  TASK
  MESSAGE
  REVIEW
  PAYMENT
  DISPUTE
  SYSTEM
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TaskStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
  DISPUTED
}

enum LocationType {
  IN_PERSON
  REMOTE
}

enum TimeType {
  ASAP
  SPECIFIC_DATE
  FLEXIBLE
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

// ---------------------------------------------------------------------------
// Payments & Escrow
// ---------------------------------------------------------------------------

model Wallet {
  id               String @id @default(uuid())
  userId           String @unique
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableBalance Float  @default(0)

  transactions   WalletTransaction[]
  payoutRequests PayoutRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id       String                @id @default(uuid())
  walletId String
  wallet   Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type     WalletTransactionType

  // Positive = credit to wallet, negative = debit.
  amount       Float
  balanceAfter Float

  taskId          String?
  escrowHoldId    String?
  payoutRequestId String?
  description     String?

  createdAt DateTime @default(now())

  @@index([walletId])
}

// One row per PayHere hosted-checkout attempt for funding a task's escrow.
model Payment {
  id      String        @id @default(uuid())
  taskId  String
  task    Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  payerId String
  payer   User          @relation(fields: [payerId], references: [id], onDelete: Cascade)
  amount  Float
  currency String       @default("LKR")
  status  PaymentStatus @default(INITIATED)

  // PayHere identifiers - orderId is ours (generated), paymentId is theirs (from IPN).
  payhereOrderId    String @unique
  payherePaymentId  String?
  payhereRawPayload Json?

  escrowHold EscrowHold?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([payerId])
}

// Funds held against a single assigned task until release/refund.
model EscrowHold {
  id        String  @id @default(uuid())
  taskId    String  @unique
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amount      Float // full amount held (the accepted offer amount)
  platformFee Float @default(0) // computed at release time from PlatformConfig

  status EscrowStatus @default(HELD)

  releasedAt       DateTime?
  refundedAt       DateTime?
  resolutionSource String? // COMPLETION | DISPUTE | CANCELLATION

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankAccount {
  id                String  @id @default(uuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName          String
  branch            String
  accountHolderName String
  accountNumber     String
  isDefault         Boolean @default(true)

  payoutRequests PayoutRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PayoutRequest {
  id            String      @id @default(uuid())
  walletId      String
  wallet        Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  amount        Float
  status        PayoutStatus @default(PENDING)

  processedById String?
  processedBy   User?     @relation("PayoutsProcessed", fields: [processedById], references: [id])
  processedAt   DateTime?
  adminNotes    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId])
  @@index([status])
}

// Singleton row holding platform-wide, admin-configurable payment settings.
model PlatformConfig {
  id                 String   @id @default("singleton")
  platformFeePercent Float    @default(10)
  updatedAt          DateTime @updatedAt
}

enum PaymentStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

enum WalletTransactionType {
  ESCROW_RELEASE
  PLATFORM_FEE
  WITHDRAWAL
  ADJUSTMENT
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}
